        "message": "<SearchInput> doesn't accept that prop. Declared props: placeholder, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: title, action, children."
