        "selector": "JSXOpeningElement[name.name='HistoryItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|time|onOpen|key|ref|className|style|children)$/]",
        "message": "<HistoryItem> doesn't accept that prop. Declared props: question, time, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|onClick|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, active, onClick, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|type|error|disabled|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: placeholder, value, onChange, type, error, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='KnowledgeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|type|updated|onOpen|key|ref|className|style|children)$/]",
        "message": "<KnowledgeCard> doesn't accept that prop. Declared props: title, type, updated, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='Listbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|selected|onSelect|key|ref|className|style|children)$/]",
        "message": "<Listbox> doesn't accept that prop. Declared props: items, selected, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|onClick|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: icon, label, active, onClick."
      },
