        "selector": "JSXOpeningElement[name.name='Popover'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|children|anchorStyle|key|ref|className|style|children)$/]",
        "message": "<Popover> doesn't accept that prop. Declared props: open, children, anchorStyle."
      },
