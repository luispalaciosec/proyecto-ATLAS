# Atlas environment variables (example — never commit real secrets)

# Persistent memory file used by atlas memory/plan/chat/ask
ATLAS_MEMORY_FILE=

# LLM provider configuration for atlas ask (P2.1)
# Supported: anthropic, openai-compatible
ATLAS_LLM_PROVIDER=anthropic
ATLAS_LLM_API_KEY=
ATLAS_LLM_MODEL=
# Optional for openai-compatible (Qwen Cloud default when omitted):
# ATLAS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ATLAS_LLM_BASE_URL=
