{
  "name": "@atlas/sdk",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Public facade for the Atlas Kernel — orchestrates core, compiler, events, and runtime",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atlas/core": "workspace:*",
    "@atlas/compiler": "workspace:*",
    "@atlas/events": "workspace:*",
    "@atlas/intelligence": "workspace:*",
    "@atlas/knowledge": "workspace:*",
    "@atlas/memory": "workspace:*",
    "@atlas/retrieval": "workspace:*",
    "@atlas/runtime": "workspace:*",
    "@atlas/workflow": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.8"
  }
}
