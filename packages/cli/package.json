{
  "name": "@atlas/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas CLI — human interface to the Kernel via @atlas/sdk",
  "license": "UNLICENSED",
  "bin": {
    "atlas": "./dist/atlas.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap && tsup src/bin/atlas.ts --format esm --sourcemap",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atlas/sdk": "workspace:*",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.8"
  }
}
