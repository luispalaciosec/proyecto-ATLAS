{
  "name": "@atlas/knowledge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Atlas Knowledge Capability — metamodel and domain core",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metamodel": {
      "types": "./dist/metamodel/index.d.ts",
      "import": "./dist/metamodel/index.js"
    },
    "./compiler-adapter": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/metamodel/index.ts src/adapters/index.ts --format esm --dts --clean --sourcemap",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atlas/compiler": "workspace:*",
    "@atlas/core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.8"
  }
}
