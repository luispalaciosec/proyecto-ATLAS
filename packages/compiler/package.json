{
  "name": "@atlas/compiler",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Atlas compiler contracts, pipeline, and deterministic compilation orchestration",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atlas/core": "workspace:*",
    "@atlas/events": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.8"
  }
}
